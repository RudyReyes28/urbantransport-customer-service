
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# Base de datos
DB_URL=jdbc:postgresql://<host>:5432/customer_db
DB_USER=
DB_PASSWORD=

# Identity (IP privada de la EC2 de identity)
IDENTITY_JWKS_URI=http://<IP_PRIVADA_IDENTITY>/.well-known/jwks.json
IDENTITY_URL=http://<IP_PRIVADA_IDENTITY>

# Clave compartida con identity (debe ser idéntica en ambos)
INTERNAL_API_KEY=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092